package templates

templ WorkPage() {
	@layout() {
		<div class="work-page">
			<h1>my work</h1>
			<p class="work-subtitle">things i've built, contributed to, and shipped</p>
			<div class="work-grid">
				<div class="project-card featured">
					<div class="project-header">
						<a href="https://github.com/run-llama/llama_index" target="_blank" class="project-title">llama index</a>
						<span class="project-stars">★ 47.8k</span>
					</div>
					<p class="project-desc">The leading document agent and OCR platform for LLMs. Core contributor to the open-source framework powering RAG applications worldwide.</p>
					<div class="project-tags">
						<span class="tag">python</span>
						<span class="tag">llm</span>
						<span class="tag">rag</span>
						<span class="tag">open-source</span>
					</div>
					<div class="project-links">
						<a href="https://github.com/run-llama/llama_index" target="_blank">github ↗</a>
						<a href="https://docs.llamaindex.ai" target="_blank">docs ↗</a>
					</div>
				</div>
				<div class="project-card featured">
					<div class="project-header">
						<a href="https://github.com/aliyeysides/prisma-gpt" target="_blank" class="project-title">prisma-gpt</a>
						<span class="project-stars">★ 55</span>
					</div>
					<p class="project-desc">Prisma extension that lets you query your database with natural language using GPT. Translates English to SQL through your Prisma schema.</p>
					<div class="project-tags">
						<span class="tag">typescript</span>
						<span class="tag">prisma</span>
						<span class="tag">gpt</span>
						<span class="tag">dx</span>
					</div>
					<div class="project-links">
						<a href="https://github.com/aliyeysides/prisma-gpt" target="_blank">github ↗</a>
					</div>
				</div>
				<div class="project-card">
					<div class="project-header">
						<a href="https://brikmate.com" target="_blank" class="project-title">brikmate</a>
					</div>
					<p class="project-desc">Full-stack product development for a real estate technology platform.</p>
					<div class="project-tags">
						<span class="tag">product</span>
						<span class="tag">real-estate</span>
						<span class="tag">full-stack</span>
					</div>
					<div class="project-links">
						<a href="https://brikmate.com" target="_blank">live ↗</a>
					</div>
