package templates

templ AboutPage() {
	@layout() {
		<body>
			<div class="about-page">
				<h1>colophon</h1>
				<section class="about-section">
					<h2>what this is</h2>
					<p>
						a personal dumping ground for things i make, things i like, and whatever else
						i feel like putting on the internet. no grand vision — just a place to tinker.
					</p>
				</section>
				<section class="about-section">
					<h2>how it's built</h2>
					<p>
						built with <a href="https://templ.guide" target="_blank">Go + Templ</a>,
						deployed on <a href="https://fly.io" target="_blank">Fly.io</a>.
						source is <a href="https://github.com/aliyeysides/personal-site" target="_blank">on GitHub</a>.
					</p>
				</section>
				<section class="about-section">
					<h2>how it's run</h2>
					<p>
						co-managed by me and my AI agent <strong>Ted</strong>, powered by
						<a href="https://openclaw.com" target="_blank">OpenClaw</a>.
						i text ideas on Telegram, Ted builds and ships them.
						most of what you see here was pair-programmed over text.
					</p>
				</section>
			</div>
		</body>
	}
}
