package templates

templ CVPage() {
	@layout() {
		<div class="cv-page">
			<div class="cv-intro">
				<h1>cv</h1>
				<p class="cv-subtitle">founder · engineer · builder</p>
				<p class="cv-bio">
					I started with a hookah cafe in Pennsylvania, taught myself to code, and never stopped building.
					From fintech platforms serving 300K+ clients at Vanguard to AI-powered real estate tools at BrikMate —
					I've moved between individual contributor, engineering manager, and founder roles,
					always drawn to the intersection of technology and entrepreneurship.
				</p>
				<div class="cv-languages">
					<span class="cv-lang">English</span>
					<span class="cv-lang-sep">·</span>
					<span class="cv-lang">Türkçe</span>
				</div>
			</div>

			<div class="cv-timeline">
				<div class="timeline-line"></div>

				<!-- BrikMate -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Jul 2023 — Aug 2025</div>
					<div class="timeline-card">
						<div class="timeline-role">Co-Founder</div>
						<div class="timeline-company">BrikMate</div>
						<div class="timeline-meta">Remote · 2 yrs 2 mos</div>
						<div class="timeline-tags">
							<span class="tag">founder</span>
							<span class="tag">real-estate</span>
							<span class="tag">ai</span>
						</div>
					</div>
				</div>

				<!-- The Mint -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Mar 2024 — May 2024</div>
					<div class="timeline-card">
						<div class="timeline-role">Entrepreneur in Residence</div>
						<div class="timeline-company">The Mint</div>
						<div class="timeline-meta">San Francisco, CA · 3 mos</div>
						<div class="timeline-tags">
							<span class="tag">founder</span>
							<span class="tag">incubator</span>
						</div>
					</div>
				</div>

				<!-- Antler -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Oct 2022 — Nov 2022</div>
					<div class="timeline-card">
						<div class="timeline-role">Entrepreneur in Residence</div>
						<div class="timeline-company">Antler</div>
						<div class="timeline-meta">NYC Metro Area · 2 mos</div>
						<div class="timeline-tags">
							<span class="tag">founder</span>
							<span class="tag">vc</span>
						</div>
					</div>
				</div>

				<!-- Localize -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Apr 2021 — Nov 2021</div>
					<div class="timeline-card">
						<div class="timeline-role">Full Stack Engineer</div>
						<div class="timeline-company">Localize</div>
						<div class="timeline-meta">Remote · 8 mos</div>
						<div class="timeline-tags">
							<span class="tag">ic</span>
							<span class="tag">i18n</span>
							<span class="tag">saas</span>
						</div>
					</div>
				</div>

				<!-- Vanguard - Dev Manager -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Jan 2020 — Apr 2021</div>
					<div class="timeline-card">
						<div class="timeline-role">Development Manager</div>
						<div class="timeline-company">Vanguard</div>
						<div class="timeline-meta">Philadelphia, PA · 1 yr 4 mos</div>
						<div class="timeline-tags">
							<span class="tag">manager</span>
							<span class="tag">fintech</span>
							<span class="tag">enterprise</span>
						</div>
					</div>
				</div>

				<!-- Vanguard - Innovation Dev -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Jul 2018 — Jan 2020</div>
					<div class="timeline-card">
						<div class="timeline-role">Innovation Developer</div>
						<div class="timeline-company">Vanguard</div>
						<div class="timeline-meta">Greater Philadelphia · 1 yr 7 mos</div>
						<div class="timeline-tags">
							<span class="tag">ic</span>
							<span class="tag">fintech</span>
						</div>
					</div>
				</div>

				<!-- Chaikin Analytics -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Mar 2017 — Jun 2018</div>
					<div class="timeline-card">
						<div class="timeline-role">Software Engineer</div>
						<div class="timeline-company">Chaikin Analytics</div>
						<div class="timeline-meta">Philadelphia, PA · 1 yr 4 mos</div>
						<div class="timeline-tags">
							<span class="tag">ic</span>
							<span class="tag">fintech</span>
						</div>
					</div>
				</div>

				<!-- Jarvus Innovations -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Apr 2016 — Mar 2017</div>
					<div class="timeline-card">
						<div class="timeline-role">Consulting Software Engineer</div>
						<div class="timeline-company">Jarvus Innovations</div>
						<div class="timeline-meta">Philadelphia, PA · 1 yr</div>
						<div class="timeline-tags">
							<span class="tag">ic</span>
							<span class="tag">consulting</span>
						</div>
					</div>
				</div>

				<!-- OnCourse -->
				<div class="timeline-entry">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Jun 2015 — Mar 2016</div>
					<div class="timeline-card">
						<div class="timeline-role">Software Engineer</div>
						<div class="timeline-company">OnCourse Systems for Education</div>
						<div class="timeline-meta">Media, PA · 10 mos</div>
						<div class="timeline-tags">
							<span class="tag">ic</span>
							<span class="tag">edtech</span>
						</div>
					</div>
				</div>

				<!-- Tulip -->
				<div class="timeline-entry origin">
					<div class="timeline-dot"></div>
					<div class="timeline-date">Aug 2010 — Sep 2012</div>
					<div class="timeline-card">
						<div class="timeline-role">Founder</div>
						<div class="timeline-company">Tulip Hookah Cafe</div>
						<div class="timeline-meta">Langhorne, PA · 2 yrs 2 mos</div>
						<div class="timeline-desc">where it all started</div>
						<div class="timeline-tags">
							<span class="tag">founder</span>
							<span class="tag">first venture</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
